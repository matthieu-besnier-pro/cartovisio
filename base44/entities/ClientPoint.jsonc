      "type": "string"
    },
    "telephone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "siret": {
      "type": "string"
    },
    "identiteJuridique": {
      "type": "string",
      "description": "SOCIETE / PARTICULIER"
    },
    "naf": {
      "type": "string",
      "description": "naf_libelle — activité"
    },
    "effectifs": {
      "type": "string"
    },
    "adresse": {
      "type": "string"
    },
    "codePostal": {
      "type": "string"
    },
    "ville": {
      "type": "string"
    },
    "departement": {
      "type": "string"
    },
