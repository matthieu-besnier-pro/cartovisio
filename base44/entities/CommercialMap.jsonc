{
  "name": "CommercialMap",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "overlays": {
      "type": "string",
      "description": "JSON string of overlays array [{id,name,cV,vColors,opacity,visible}]"
    },
    "mapView": {
      "type": "string",
      "description": "JSON string {lat,lng,zoom}"
    },
    "departments": {
      "type": "string",
      "description": "JSON string array of department codes loaded"
    },
    "markers": {
      "type": "string",
      "description": "JSON string of markers array [{id,lat,lng,name}]"
    },
    "isochrones": {
      "type": "string",
      "description": "JSON string (or uploaded file URL) of saved isochrones [{id,lat,lng,label,profile,minutes,geojson}]"
    },
    "shareToken": {
      "type": "string",
      "description": "Unique public share token"
    },
    "isPublic": {
      "type": "boolean",
      "default": true
    },
    "accentColor": {
      "type": "string",
      "default": "#f43f5e"
    },
    "coverColor": {
      "type": "string",
      "default": "#0f172a"
    }
  },
  "required": [
    "title"
  ]
}